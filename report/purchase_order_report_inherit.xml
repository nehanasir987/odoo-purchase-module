<odoo>
    <template id="report_purchaseorder_document_inherit" 
              inherit_id="purchase.report_purchaseorder_document">
        
        <xpath expr="//strong[contains(text(),'Order Date')]" position="replace">
            <strong>Date:</strong>
        </xpath>



        <xpath expr="//strong[contains(text(),'Expected Arrival')]" position="replace">
            <strong>expiration:</strong>
        </xpath>



        <xpath expr="//strong[contains(text(),'Payment Terms')]" position="replace">
            <strong>payment</strong>
        </xpath>
        




        <xpath expr="//strong[contains(text(),'payment')]" position="after">
            <br/>
            <div t-if="o.qr_code" class="mt-2">
                <img t-att-src="image_data_uri(o.qr_code)" style="width:120px;height:120px;"/>
            </div>
        </xpath>
        
    </template>
</odoo>